{
  "name": "natui-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen && fumadocs-mdx",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "check": "pnpm run typecheck && node scripts/check-docs.mjs && node scripts/check-components.mjs && node scripts/typecheck-examples.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.11.5",
    "fumadocs-ui": "16.11.5",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-typescript": "5.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.5.4"
  }
}
