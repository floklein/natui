<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NatuiHost</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>

    <!-- WinUI 3 has no AnyCPU: builds are platform-specific. The explicit
         RuntimeIdentifier keeps plain `dotnet build` working; pass
         -p:Platform=arm64 -p:RuntimeIdentifier=win-arm64 for ARM builds. -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- Unpackaged (no MSIX): the output is a plain exe Node can spawn. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Carry the Windows App SDK runtime next to the exe: no machine-wide
         installer needed, and reg-free WinRT is enabled automatically. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Carry the .NET runtime too, so spawning from Node has zero prereqs. -->
    <SelfContained>true</SelfContained>

    <!-- We provide our own Main (Program.cs); no XAML-generated entry point. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
</Project>
