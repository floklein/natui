<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NatuiHost</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>

    <!-- WinUI 3 has no AnyCPU: builds are platform-specific. The explicit
         RuntimeIdentifier keeps plain `dotnet build` working; pass
         -p:Platform=arm64 -p:RuntimeIdentifier=win-arm64 for ARM builds. -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- Unpackaged (no MSIX): the output is a plain exe Node can spawn. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Carry the Windows App SDK runtime next to the exe: no machine-wide
         installer needed, and reg-free WinRT is enabled automatically. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Carry the .NET runtime too, so spawning from Node has zero prereqs. -->
    <SelfContained>true</SelfContained>

    <!-- We provide our own Main (Program.cs); no XAML-generated entry point. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- A code-only project has no Page/PriResource items, so the WASDK
         targets skip PRI generation by default. Force it: without a merged
         resources.pri next to the exe, ms-appx resource resolution fails at
         runtime and XamlControlsResources throws "Cannot locate resource
         from 'ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml'". -->
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1" />
    <PackageReference
      Include="Microsoft.ClearScript.V8.Native.win-x64"
      Version="7.5.1"
      Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference
      Include="Microsoft.ClearScript.V8.Native.win-arm64"
      Version="7.5.1"
      Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260505002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

  <!-- A packaged application passes NatuiAppDirectory at publish time. Keep
       its validated manifest and IIFE inside the managed assembly, which in
       turn is carried by the self-contained single-file app host. Development
       host builds omit these resources and retain explicit bundle and stdin
       behavior. -->
  <ItemGroup Condition="'$(NatuiAppDirectory)' != ''">
    <EmbeddedResource
      Include="$(NatuiAppDirectory)\manifest.json"
      LogicalName="NatuiHost.App.manifest.json" />
    <EmbeddedResource
      Include="$(NatuiAppDirectory)\main.js"
      LogicalName="NatuiHost.App.main.js" />
    <EmbeddedResource
      Include="$(MSBuildProjectDirectory)\..\..\..\LICENSE"
      LogicalName="NatuiHost.App.LICENSE.txt" />
  </ItemGroup>
</Project>
