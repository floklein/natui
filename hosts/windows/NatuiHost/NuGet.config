<?xml version="1.0" encoding="utf-8"?>
<!-- Some machines only have the Visual Studio offline feed configured; the
     WASDK packages live on nuget.org, so pin it here for this project. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
