{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natui.dev/schemas/natui-bundle.schema.json",
  "title": "NatUI packaged application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "buildNumber",
    "entry",
    "entrySha256",
    "protocolVersion",
    "minHostApi",
    "platform",
    "architecture"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?![\\s\\uFEFF])(?=[\\s\\S]*[^\\s\\uFEFF]$)(?![\\s\\S]*[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\uFFFE\\uFFFF])[\\s\\S]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\.0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\.0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "buildNumber": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "entry": {
      "const": "main.js"
    },
    "entrySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocolVersion": {
      "const": 1
    },
    "minHostApi": {
      "const": 2
    },
    "platform": {
      "enum": [
        "macos",
        "windows"
      ]
    },
    "architecture": {
      "enum": [
        "x64",
        "arm64"
      ]
    }
  }
}
