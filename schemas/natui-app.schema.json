{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natui.dev/schemas/natui-app.schema.json",
  "title": "NatUI application package configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "buildNumber",
    "entry",
    "executable"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "buildNumber": {
      "type": "string",
      "pattern": "^[1-9]\\d*$"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "macos": {
          "type": "string",
          "minLength": 1
        },
        "windows": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
