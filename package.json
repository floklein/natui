{
  "name": "natui-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Write React TypeScript, render real native UI: SwiftUI on macOS, WinUI 3 on Windows.",
  "scripts": {
    "build": "pnpm --filter @natui/core build && pnpm --filter @natui/dev build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @natui/core test && pnpm --filter @natui/dev test && node --test tools/package-app.test.mjs && pnpm --filter create-natui-app test",
    "build:host:macos": "swift build -c release --package-path hosts/macos",
    "dev": "pnpm demo",
    "demo": "pnpm build && pnpm --filter natui-demo dev",
    "demo:start": "pnpm build && pnpm --filter natui-demo start",
    "verify": "pnpm build && pnpm --filter natui-demo verify",
    "verify:kitchen": "pnpm build && pnpm --filter natui-kitchen-sink verify",
    "verify:embedded": "pnpm build && pnpm --filter natui-demo build:embedded && node examples/demo/src/verify-embedded.mjs",
    "verify:windows-runtime-failure": "pnpm build && node examples/demo/src/verify-windows-runtime-failure.mjs",
    "package:demo": "pnpm build && node tools/package-demo.mjs",
    "verify:package": "pnpm package:demo && node examples/demo/src/verify-package.mjs && node examples/demo/src/verify-macos-launchservices.mjs",
    "release:check": "node tools/verify-release.mjs",
    "docs:dev": "pnpm --filter natui-docs dev",
    "docs:check": "pnpm --filter natui-docs check",
    "docs:build": "pnpm --filter natui-docs build",
    "docs:start": "pnpm --filter natui-docs start",
    "docs:smoke": "pnpm --filter natui-docs smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.1.0"
}
