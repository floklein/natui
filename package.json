{
  "name": "natui-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Write React TypeScript, render real native UI: SwiftUI on macOS, WinUI 3 on Windows.",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter natui test",
    "build:host:macos": "swift build -c release --package-path hosts/macos",
    "demo": "pnpm --filter natui-demo dev"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@11.1.0"
}
