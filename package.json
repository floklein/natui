{
  "name": "natui-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Write React TypeScript, render real native UI: SwiftUI on macOS, WinUI 3 on Windows.",
  "scripts": {
    "build": "pnpm --filter @natui/core build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @natui/core test && node --test tools/package-app.test.mjs && pnpm --filter create-natui-app test",
    "build:host:macos": "swift build -c release --package-path hosts/macos",
    "dev": "pnpm demo",
    "demo": "pnpm --filter @natui/core build && pnpm --filter natui-demo dev",
    "demo:start": "pnpm --filter @natui/core build && pnpm --filter natui-demo start",
    "verify": "pnpm --filter @natui/core build && pnpm --filter natui-demo verify",
    "verify:kitchen": "pnpm --filter @natui/core build && pnpm --filter natui-kitchen-sink verify",
    "verify:embedded": "pnpm --filter @natui/core build && pnpm --filter natui-demo build:embedded && node examples/demo/src/verify-embedded.mjs",
    "verify:windows-runtime-failure": "pnpm --filter @natui/core build && node examples/demo/src/verify-windows-runtime-failure.mjs",
    "package:demo": "pnpm --filter @natui/core build && node tools/package-demo.mjs",
    "verify:package": "pnpm package:demo && node examples/demo/src/verify-package.mjs",
    "release:check": "node tools/verify-release.mjs",
    "docs:dev": "pnpm --filter natui-docs dev",
    "docs:check": "pnpm --filter natui-docs check",
    "docs:build": "pnpm --filter natui-docs build",
    "docs:start": "pnpm --filter natui-docs start",
    "docs:smoke": "pnpm --filter natui-docs smoke"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@11.1.0"
}
