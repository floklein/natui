{
  "name": "natui-poc",
  "version": "0.1.0",
  "private": true,
  "description": "React TypeScript to native SwiftUI and WinUI proof of concept",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:poc": "npm run build && node packages/cli/dist/cli.js build all",
    "check": "npm run typecheck && npm test",
    "clean": "tsc -b --clean",
    "dev": "tsx packages/cli/src/cli.ts build macos",
    "doctor": "tsx packages/cli/src/cli.ts doctor",
    "smoke:controller": "npm run build && tsx scripts/smoke-controller.ts",
    "smoke:windows-controller": "npm run build && tsx scripts/smoke-controller.ts --windows",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "@types/react": "19.2.17",
    "@types/react-reconciler": "0.33.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
