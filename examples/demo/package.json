{
  "name": "natui-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "natui dev src/main.tsx",
    "start": "tsx src/main.tsx",
    "verify": "tsx src/verify.tsx",
    "build:embedded": "esbuild src/main-embedded.tsx --bundle --format=iife --platform=browser --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=dist/embedded.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@natui/core": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
