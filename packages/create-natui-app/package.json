{
  "name": "create-natui-app",
  "version": "0.2.0",
  "description": "Create a new NatUI application.",
  "license": "MIT",
  "keywords": [
    "natui",
    "react",
    "native",
    "desktop",
    "swiftui",
    "winui",
    "scaffold"
  ],
  "homepage": "https://natui.dev",
  "bugs": {
