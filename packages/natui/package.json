{
  "name": "@natui/core",
  "version": "0.2.0",
  "description": "Write React TypeScript, render real native UI: SwiftUI on macOS, WinUI 3 on Windows.",
  "license": "MIT",
  "keywords": [
    "react",
    "native",
    "desktop",
    "swiftui",
    "winui"
  ],
  "homepage": "https://natui.dev",
  "bugs": {
    "url": "https://github.com/floklein/natui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floklein/natui.git",
    "directory": "packages/natui"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "natui": "./bin/natui.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./inproc": {
      "types": "./dist/inproc.d.ts",
      "import": "./dist/inproc.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./config": {
      "types": "./app-config.d.ts",
      "import": "./app-config.js"
    }
  },
  "files": [
    "app-config.d.ts",
    "app-config.js",
    "bin",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\" \"test/**/*.test.tsx\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-reconciler": "0.33.0",
    "react": "19.2.8",
    "react-refresh": "0.18.0",
    "typescript": "^5.5.4"
  }
}
