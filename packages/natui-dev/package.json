{
  "name": "@natui/dev",
  "version": "0.2.0",
  "description": "Development server with React Fast Refresh for NatUI applications.",
  "license": "MIT",
  "keywords": [
    "natui",
    "react",
    "fast-refresh",
    "dev-server"
  ],
  "homepage": "https://natui.dev",
  "bugs": {
    "url": "https://github.com/floklein/natui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floklein/natui.git",
    "directory": "packages/natui-dev"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\" \"test/**/*.test.tsx\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "esbuild": "^0.28.0",
    "import-meta-resolve": "4.2.0",
    "react-refresh": "0.18.0",
    "rollup": "^4.62.0"
  },
  "peerDependencies": {
    "@natui/core": "workspace:^",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@natui/core": "workspace:*",
    "@types/babel__core": "7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "react": "19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
